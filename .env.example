# ==============================================
# Environment variables for the Viral Game Content Agent
# ==============================================
# Copy this file to ".env.local" and fill in the real values.
#   cp .env.example .env.local
# Then run:  pnpm install  &&  pnpm dev
# ----------------------------------------------

# --- Database (REQUIRED) ---
# A Neon Postgres connection string. Get a free one at https://neon.tech
# Without this the app cannot read/write genre weights or feedback.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Minds AI (OPTIONAL) ---
# If these are not set, the app still works but skips AI script generation
# (it returns a placeholder note instead of a real YouTube plan).
MINDS_BUILDER_API_KEY="your_minds_api_key"
HELLOMINDS_MIND_ID="your_mind_id"
